# Application Settings
PROJECT_NAME=CollabHub
ENVIRONMENT=development
API_V1_STR=/api/v1

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=collabhub

# Optional override: direct Database URL
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/collabhub

# JWT Authentication (Minimum 32 characters / 256 bits for SHA256)
# Generate a strong 256-bit secret in Python: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=generate-a-strong-256-bit-secret-using-instructions-above
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration (comma-separated or JSON list)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# SMTP Email Configuration (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=CollabHub

# Frontend Application URL
FRONTEND_URL=http://localhost:5173

# Rate Limiting Configuration
RATE_LIMITING_ENABLED=true
# RATE_LIMIT_LOGIN_MAX_REQUESTS=5
# RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
# RATE_LIMIT_REGISTER_MAX_REQUESTS=5
# RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
# RATE_LIMIT_FORGOT_PASSWORD_MAX_REQUESTS=3
# RATE_LIMIT_FORGOT_PASSWORD_WINDOW_SECONDS=3600
# RATE_LIMIT_RESET_PASSWORD_MAX_REQUESTS=5
# RATE_LIMIT_RESET_PASSWORD_WINDOW_SECONDS=3600
# RATE_LIMIT_INVITATION_VERIFY_MAX_REQUESTS=20
# RATE_LIMIT_INVITATION_VERIFY_WINDOW_SECONDS=60